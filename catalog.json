  "components": [
    {
      "name": "Button",
      "level": "atom",
      "purpose": "Starts an action.",
      "props": [
        {
          "name": "variant",
          "values": [
            "primary",
            "secondary"
          ],
          "default": "secondary",
          "job": "Chooses the single primary action or a secondary action."
        },
        {
          "name": "children",
          "job": "The label a person reads."
        },
        {
          "name": "disabled",
          "default": "false",
          "job": "Turns the action off."
        },
        {
          "name": "type",
          "values": [
            "button",
            "submit",
            "reset"
          ],
          "default": "button",
          "job": "Sets the button behavior."
        }
      ],
      "whenToUse": "Use `primary` for the single main action on a screen. Use `secondary` for every other action.",
      "whenNotToUse": "Do not use two primary buttons on one screen. Do not use a button for navigation that should be a link later. Do not put a raw color on it."
    },
    {
      "name": "TextInput",
      "level": "atom",
      "purpose": "Collects one short line of text.",
      "props": [
        {
          "name": "label",
          "required": true,
          "job": "Visible name of the field."
        }
      ],
      "whenToUse": "Use it for a single short answer, such as a name.",
      "whenNotToUse": "Do not use it for a long answer, a choice, or a search that needs its own molecule. Do not leave the field unlabeled."
    },
    {
      "name": "Type",
      "level": "atom",
      "purpose": "Applies a semantic type style.",
      "props": [
        {
          "name": "kind",
          "values": [
            "display",
            "title",
            "body",
            "label"
          ],
          "default": "body",
          "job": "Picks the semantic type style."
        },
        {
          "name": "children",
          "job": "The text."
        }
      ],
      "whenToUse": "Use `display` once for the page title, `title` for a section, `body` for reading text, and `label` for a short caption.",
      "whenNotToUse": "Do not set a font size, family, or weight in the caller. Do not use display more than once on a screen."
    },
    {
      "name": "Badge",
      "level": "atom",
      "purpose": "Names a status.",
      "props": [
        {
          "name": "tone",
          "values": [
            "success",
            "warning",
            "error",
            "info"
          ],
          "job": "Names the status."
        },
        {
          "name": "children",
          "job": "The status label."
        }
      ],
      "whenToUse": "Use it to mark a state the person needs to notice, next to the thing it describes.",
      "whenNotToUse": "Do not use it as a button. Do not invent a tone outside the four status roles."
    },
    {
      "name": "Icon",
      "level": "atom",
      "purpose": "Draws one icon from the active icon set.",
      "props": [
        {
          "name": "name",
          "values": [
            "plus",
            "search",
            "check",
            "info"
          ],
          "job": "Which icon to draw."
        },
        {
          "name": "iconSetId",
          "values": [
            "lucide"
          ],
          "job": "The icon set. Any other set fails."
        }
      ],
      "whenToUse": "Use it inside a control or next to a short label. The size comes from `size.icon`.",
      "whenNotToUse": "Do not import an icon library from a component. Do not use an icon as the only primary action."
    }
  ],
  "rules": [
    {
      "id": 1,
      "rule": "Read AGENTS.md, then RULES.md, then catalog.json, then the component doc for the piece you change.",
      "why": "An agent that skips this order invents a piece that is not in the system.",
      "doc": "SKILL.md"
    },
    {
      "id": 2,
      "rule": "The repo is the source of truth. Figma mirrors it.",
      "why": "Two sources that both lead will drift.",
      "doc": "RULES.md"
    },
    {
      "id": 3,
      "rule": "Components use semantic tokens such as color.action.primary.",
      "why": "A theme can restyle every screen without a component edit.",
      "doc": "RULES.md"
    },
    {
      "id": 4,
      "rule": "Do not rename a role in tokens/schema.json.",
      "why": "Every reader keys off those names.",
      "doc": "tokens/schema.json"
    },
    {
      "id": 5,
      "rule": "A theme supplies values only. It cannot replace a component.",
      "why": "A brand fills the kit. It does not fork the kit.",
      "doc": "RULES.md"
    },
    {
      "id": 6,
      "rule": "Gray steps stay 0 through 900.",
      "why": "A brand fills the steps. It does not add a step.",
      "doc": "RULES.md"
    },
    {
      "id": 7,
      "rule": "Status hues stay success, warning, error, and info.",
      "why": "A brand may change the color. It may not change the meaning.",
      "doc": "RULES.md"
    },
    {
      "id": 8,
      "rule": "Tap targets use size.tap.",
      "why": "One target size keeps controls easy to hit.",
      "doc": "RULES.md"
    },
    {
      "id": 9,
      "rule": "Harbor is a test theme, not a brand.",
      "why": "It exists to prove a second accent restyles the system.",
      "doc": "themes/harbor.json"
    },
    {
      "id": 10,
      "rule": "Every component has a purpose, props, when to use, and when not to use.",
      "why": "Agents choose from those facts.",
      "doc": "catalog.json"
    },
    {
      "id": 11,
      "rule": "One primary action per screen.",
      "why": "A screen with two primary buttons hides the main action.",
      "doc": "SKILL.md"
    },
    {
      "id": 12,
      "rule": "Chunk a screen into small groups.",
      "why": "A person can hold only a few choices at once.",
      "doc": "RULES.md"
    },
    {
      "id": 13,
      "rule": "Prefer a documented prop over a new component.",
      "why": "Fewer pieces stay easier to use correctly.",
      "doc": "RULES.md"
    },
    {
      "id": 14,
      "rule": "Icons go through icons/. Lucide is the default set.",
      "why": "The icon set can be swapped without rewriting components.",
      "doc": "RULES.md"
    },
    {
      "id": 15,
      "rule": "Run build:tokens and build:catalog, and commit both outputs.",
      "why": "People and agents then read the same values.",
      "doc": "README.md"
    },
    {
      "id": 16,
      "rule": "Do not hand-edit catalog.json or AGENTS.md.",
      "why": "Both files are generated. A hand edit will fail the check.",
      "doc": "SKILL.md"
    },
    {
      "id": 17,
      "rule": "Schema and raw-value checks block.",
      "why": "A broken theme or a raw color should not merge.",
      "doc": "RULES.md"
    },
    {
      "id": 18,
      "rule": "The first live surface is web, and the first export is CSS variables.",
      "why": "Social, thumbnail, video, and Tailwind wait until this base is the source.",
      "doc": "BRIEF.md"
    }
  ]
}
